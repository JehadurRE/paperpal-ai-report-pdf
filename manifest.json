{
  "manifest_version": 3,
  "name": "Paperpal Visible Report PDF Exporter",
  "version": "1.1.0",
  "author": "JehadurRE",
  "homepage_url": "https://github.com/JehadurRE/paperpal-ai-report-pdf",
  "description": "Exports visible Paperpal AI Detection reports and Plagiarism Free Overview cards into clean, vector PDFs without scroll clipping.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Export Paperpal Report to PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "https://edit.paperpal.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://edit.paperpal.com/*"
      ],
      "js": [
        "extractor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
